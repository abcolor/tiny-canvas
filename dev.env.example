# 本機開發用的環境變數範本。複製成 dev.env 後使用：cp dev.env.example dev.env
NODE_ENV=development
DATABASE_URL=postgresql://tinycanvas:tinycanvas@localhost:54329/tinycanvas
TEST_DATABASE_URL=postgresql://tinycanvas:tinycanvas@localhost:54329/tinycanvas_test
# 至少 32 個字元，只用於本機開發；可用 `openssl rand -hex 32` 產生
SESSION_SECRET=dev-only-insecure-session-secret-change-me
PUBLIC_URL=http://localhost:5273
ALLOW_SIGNUP=true
VERSION_RETENTION_DAYS=0
STORAGE_LOCAL_DIR=.data/files
SYNC_TEST_DATABASE_URL=postgresql://tinycanvas:tinycanvas@localhost:54329/tinycanvas_test_sync
