{$DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 12MB
  }
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /sync* {
    reverse_proxy sync:4000
  }
  handle {
    root * /srv/web
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
  }
}
