{
  "name": "tinycanvas",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@tinycanvas/web --filter=@tinycanvas/api --filter=@tinycanvas/sync",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "perf": "pnpm --filter @tinycanvas/canvas-engine perf",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @tinycanvas/db migrate:dev",
    "db:generate": "pnpm --filter @tinycanvas/db generate",
    "db:deploy": "pnpm --filter @tinycanvas/db deploy:dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  }
}
